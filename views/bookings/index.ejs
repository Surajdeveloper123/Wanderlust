<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <h3>Your Booked Listings</h3>
  <% for(let booking of allBookings) { %>
    <div class="card col-3 offset-2 listing-card">
      <div class="card-body">
        <p class="card-text">
          <b>Listing ID:</b> <%= booking.listing ? booking.listing.title : "N/A" %> <br>
          <b>Check-in:</b> <%= booking.fromDate %> <br>
          <b>Check-out:</b> <%= booking.toDate %>
        </p>
      </div>
    </div>
  <% } %>
</div>